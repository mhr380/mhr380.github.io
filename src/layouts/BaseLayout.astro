---
import "../styles/style.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site, withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const {
  title,
  description = site.description,
  type = "website",
} = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = withBase(site.logoUrl);
const imageAbs = new URL(image, Astro.site).href;
---
<!DOCTYPE html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme") || "light";
        document.documentElement.setAttribute("data-theme", t);
        document.documentElement.style.backgroundColor = t === "dark" ? "#111111" : "#fcfbf8";
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="icon" href={image} type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase("/rss.xml")} />
    {site.socialShare && (
      <>
        <meta property="og:title" content={title || site.title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageAbs} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content={type} />
        <meta name="twitter:card" content="summary" />
      </>
    )}
    {site.math && (
      <script is:inline defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    )}
  </head>
  <body>
    <ThemeToggle />
    <Header />
    <div id="content">
      <slot />
    </div>
    <Footer />
  </body>
</html>
